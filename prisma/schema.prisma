datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String           @id @default(uuid())
  email               String           @unique
  username            String           @unique
  avatarUrl           String?
  theme               String           @default("DARK")
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  playlists           Playlist[]
  playlistMemberships PlaylistMember[]
  addedSongs          PlaylistSong[]
}

model Playlist {
  id                   String           @id @default(uuid())
  name                 String
  coverUrl             String?
  userId               String
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  songs                PlaylistSong[]
  members              PlaylistMember[]
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  description          String?          @db.VarChar(300)
  is_public            Boolean          @default(true)
  is_owner_deleted     Boolean          @default(false)
  originalOwnerId      String?
  is_collaborative     Boolean          @default(false)
  allow_member_editing Boolean          @default(false)
  join_code            String?          @unique
}

model PlaylistMember {
  id         String   @id @default(uuid())
  playlistId String
  userId     String
  joinedAt   DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([playlistId, userId])
}

model Song {
  id         String         @id // Deezer Track ID
  title      String
  artist     String
  albumCover String
  duration   Int?
  playlists  PlaylistSong[]
  createdAt  DateTime       @default(now())
}

model PlaylistSong {
  playlistId String
  songId     String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  song       Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  addedAt    DateTime @default(now())
  addedById  String?
  addedBy    User?    @relation(fields: [addedById], references: [id], onDelete: SetNull)

  @@id([playlistId, songId])
}

model youtube_cache {
  query      String   @id
  video_id   String
  created_at DateTime @default(now())

  @@map("youtube_cache")
}